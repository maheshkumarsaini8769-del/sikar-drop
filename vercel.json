{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/**": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...all].js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/sitemap.xml", "destination": "/api/[...all].js" },
    { "source": "/robots.txt", "destination": "/api/[...all].js" }
  ]
}
