# ============================================================
# SIKAR DROP - Environment Variables (copy to .env.local)
# ============================================================
# IMPORTANT: Never commit .env.local to git.

NODE_ENV=production
PORT=8090
SITE_URL=https://sikar-drop.vercel.app

# --- SECURITY: Admin credentials (REQUIRED in production) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SUPER_ADMIN_PASSWORD=change-me-to-a-strong-password
SUBADMIN_PASSWORD=change-me-too

# --- SECURITY: HMAC secret for admin/truecaller tokens ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=
TRUECALLER_SECRET=

# --- SECURITY: Enable admin API auth enforcement ---
# Set to 'true' AFTER you've verified the admin panel sends X-Admin-Token.
# Until then, leave 'false' to keep existing flows working.
ENFORCE_ADMIN_AUTH=false

# --- SECURITY: Only allow test OTP 9999 in non-production ---
# Set to 'true' ONLY on your local dev machine, NEVER in production.
ALLOW_TEST_OTP=false

# --- MongoDB (optional, for cloud sync) ---
MONGODB_URI=
