# ============================================================
# SIKAR DROP - Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ============================================================

NODE_ENV=production
PORT=8090
SITE_URL=https://sikar-drop.vercel.app

# ============================================================
# REQUIRED - Server refuses to start without these in production
# ============================================================
ADMIN_TOKEN_SECRET=<paste 64-char hex from step 3 above>
TRUECALLER_SECRET=<paste 64-char hex from step 3 above>

# ============================================================
# REQUIRED - Super-admin password
# Generate a strong 14+ char password.
# On first login, the DB pin for ADM-01 is auto-synced to this value.
# ============================================================
SUPER_ADMIN_PASSWORD=<your strong super admin password>

# Sub-admin password (used only if you rely on subadmin@sikardrop.in)
SUBADMIN_PASSWORD=<your strong sub-admin password>

# ============================================================
# OPTIONAL - flip to 'true' only AFTER admin.html sends X-Admin-Token
# Leaving 'false' keeps existing admin panel working.
# ============================================================
ENFORCE_ADMIN_AUTH=false

# ============================================================
# OPTIONAL - only for local dev. NEVER set in production.
# ============================================================
ALLOW_TEST_OTP=false

# ============================================================
# MongoDB (optional - for cloud sync)
# ============================================================
MONGODB_URI=
